{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://birdcode.dev/schemas/evals/subagent-routing-v1/normalized-output.schema.v1.json",
  "title": "BirdCode normalized semantic spawn decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "causal_binding",
    "activation_source",
    "directive",
    "basis",
    "decision_reasons",
    "requested_constraints",
    "protected_obligation_ids",
    "adaptation_ids",
    "direct_work_order_refs",
    "direct_authority_ceiling",
    "spawn_proposal",
    "clarification_requests",
    "escalation_requests",
    "finish_claims"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "case_id": { "$ref": "#/$defs/stable_id" },
    "causal_binding": { "$ref": "#/$defs/causal_binding" },
    "activation_source": { "$ref": "#/$defs/activation_source" },
    "directive": { "$ref": "#/$defs/directive" },
    "basis": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/basis" }
    },
    "direct_work_order_refs": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/stable_id" }
    },
    "direct_authority_ceiling": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/authority_ceiling" }
      ]
    },
    "decision_reasons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/decision_reason" }
    },
    "requested_constraints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/requested_constraint" }
    },
    "protected_obligation_ids": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/stable_id" }
    },
    "adaptation_ids": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/adaptation_id" }
    },
    "spawn_proposal": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/spawn_proposal" }
      ]
    },
    "clarification_requests": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/clarification" }
    },
    "escalation_requests": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/escalation" }
    },
    "finish_claims": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/finish_claim" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "directive": { "const": "execute" } }, "required": ["directive"] },
      "then": {
        "properties": {
          "direct_work_order_refs": { "minItems": 1 },
          "direct_authority_ceiling": { "$ref": "#/$defs/authority_ceiling" },
          "activation_source": {
            "properties": { "kind": { "const": "none" } }
          },
          "spawn_proposal": { "type": "null" },
          "clarification_requests": { "maxItems": 0 },
          "escalation_requests": { "maxItems": 0 },
          "finish_claims": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "directive": { "const": "delegate" } }, "required": ["directive"] },
      "then": {
        "properties": {
          "direct_work_order_refs": { "maxItems": 0 },
          "direct_authority_ceiling": { "type": "null" },
          "activation_source": {
            "properties": { "kind": { "not": { "const": "none" } } }
          },
          "spawn_proposal": { "$ref": "#/$defs/spawn_proposal" },
          "clarification_requests": { "maxItems": 0 },
          "escalation_requests": { "maxItems": 0 },
          "finish_claims": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "directive": { "const": "clarify" } }, "required": ["directive"] },
      "then": {
        "properties": {
          "direct_work_order_refs": { "maxItems": 0 },
          "direct_authority_ceiling": { "type": "null" },
          "activation_source": {
            "properties": { "kind": { "const": "none" } }
          },
          "spawn_proposal": { "type": "null" },
          "clarification_requests": { "minItems": 1 },
          "escalation_requests": { "maxItems": 0 },
          "finish_claims": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "directive": { "const": "escalate" } }, "required": ["directive"] },
      "then": {
        "properties": {
          "direct_work_order_refs": { "maxItems": 0 },
          "direct_authority_ceiling": { "type": "null" },
          "activation_source": {
            "properties": { "kind": { "const": "none" } }
          },
          "spawn_proposal": { "type": "null" },
          "clarification_requests": { "maxItems": 0 },
          "escalation_requests": { "minItems": 1 },
          "finish_claims": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "directive": { "const": "finish" } }, "required": ["directive"] },
      "then": {
        "properties": {
          "direct_work_order_refs": { "maxItems": 0 },
          "direct_authority_ceiling": { "type": "null" },
          "activation_source": {
            "properties": { "kind": { "const": "none" } }
          },
          "spawn_proposal": { "type": "null" },
          "clarification_requests": { "maxItems": 0 },
          "escalation_requests": { "maxItems": 0 },
          "finish_claims": { "minItems": 1 }
        }
      }
    }
  ],
  "$defs": {
    "stable_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "causal_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_run_id",
        "parent_thread_id",
        "parent_turn_id",
        "parent_execution_id",
        "parent_attempt_id",
        "accepted_planner_event_id",
        "accepted_planner_turn_id",
        "accepted_planner_output_digest",
        "resulting_plan_digest",
        "root_snapshot_digest",
        "context_manifest_digest",
        "obligation_snapshot_digest",
        "acceptance_policy_digest",
        "evidence_packet_digest",
        "planner_policy_digest",
        "role_registry_digest",
        "capability_registry_digest",
        "model_profile_snapshot_digest"
      ],
      "properties": {
        "root_run_id": { "$ref": "#/$defs/stable_id" },
        "parent_thread_id": { "$ref": "#/$defs/stable_id" },
        "parent_turn_id": { "$ref": "#/$defs/stable_id" },
        "parent_execution_id": { "$ref": "#/$defs/stable_id" },
        "parent_attempt_id": { "$ref": "#/$defs/stable_id" },
        "accepted_planner_event_id": { "$ref": "#/$defs/stable_id" },
        "accepted_planner_turn_id": { "$ref": "#/$defs/stable_id" },
        "accepted_planner_output_digest": { "$ref": "#/$defs/digest" },
        "resulting_plan_digest": { "$ref": "#/$defs/digest" },
        "root_snapshot_digest": { "$ref": "#/$defs/digest" },
        "context_manifest_digest": { "$ref": "#/$defs/digest" },
        "obligation_snapshot_digest": { "$ref": "#/$defs/digest" },
        "acceptance_policy_digest": { "$ref": "#/$defs/digest" },
        "evidence_packet_digest": { "$ref": "#/$defs/digest" },
        "planner_policy_digest": { "$ref": "#/$defs/digest" },
        "role_registry_digest": { "$ref": "#/$defs/digest" },
        "capability_registry_digest": { "$ref": "#/$defs/digest" },
        "model_profile_snapshot_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "authority_ceiling": { "enum": ["none", "read_only", "workspace_write"] },
    "activation_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_refs"],
      "properties": {
        "kind": {
          "enum": [
            "none",
            "explicit_user_request",
            "applicable_project_instruction",
            "applicable_skill_instruction",
            "policy_permitted_proactive"
          ]
        },
        "source_refs": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stable_id" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "none" } },
            "required": ["kind"]
          },
          "then": { "properties": { "source_refs": { "maxItems": 0 } } },
          "else": { "properties": { "source_refs": { "minItems": 1 } } }
        }
      ]
    },
    "decision_reason_id": {
      "enum": [
        "direct_execution_lower_coordination_cost",
        "independent_parallel_benefit",
        "ordered_dependency",
        "independent_review_required",
        "material_user_decision_missing",
        "admission_resource_missing",
        "independent_candidate_comparison",
        "diagnosis_before_repair",
        "untrusted_content_not_activation",
        "explicit_parallel_delegation",
        "model_profile_adaptation",
        "completion_gate_satisfied",
        "completion_gate_repair"
      ]
    },
    "decision_reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "evidence_refs"],
      "properties": {
        "code": { "$ref": "#/$defs/decision_reason_id" },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stable_id" }
        }
      }
    },
    "requested_constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraint_id", "evidence_refs"],
      "properties": {
        "constraint_id": { "$ref": "#/$defs/stable_id" },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stable_id" }
        }
      }
    },
    "adaptation_id": {
      "enum": [
        "smaller_bounded_work_orders",
        "explicit_intermediate_handoffs",
        "fresh_mechanical_validation",
        "independent_semantic_review"
      ]
    },
    "directive": { "enum": ["execute", "delegate", "clarify", "escalate", "finish"] },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_ref", "rationale"],
      "properties": {
        "evidence_ref": { "$ref": "#/$defs/stable_id" },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "role_definition_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest", "role_family"],
      "properties": {
        "id": { "$ref": "#/$defs/stable_id" },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "role_family": { "$ref": "#/$defs/stable_id" }
      }
    },
    "child": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_child_ref",
        "role_definition_ref",
        "semantic_purpose",
        "objective",
        "depends_on",
        "authority_ceiling",
        "execution_shape",
        "context_policy",
        "isolation",
        "independence",
        "budget",
        "handoff_schema_id",
        "handoff_properties",
        "protected_obligation_ids",
        "acceptance_criteria",
        "evidence_refs"
      ],
      "properties": {
        "local_child_ref": { "$ref": "#/$defs/stable_id" },
        "role_definition_ref": { "$ref": "#/$defs/role_definition_ref" },
        "semantic_purpose": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "objective": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "depends_on": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stable_id" }
        },
        "authority_ceiling": { "$ref": "#/$defs/authority_ceiling" },
        "execution_shape": { "$ref": "#/$defs/execution_shape" },
        "context_policy": { "enum": ["none", "all", "bounded_recent", "exact_manifest"] },
        "isolation": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stable_id" }
        },
        "independence": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stable_id" }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_model_calls", "max_output_tokens", "max_tool_calls", "max_wall_time_ms"],
          "properties": {
            "max_model_calls": { "type": "integer", "minimum": 1 },
            "max_output_tokens": { "type": "integer", "minimum": 1 },
            "max_tool_calls": { "type": "integer", "minimum": 0 },
            "max_wall_time_ms": { "type": "integer", "minimum": 1 }
          }
        },
        "handoff_schema_id": { "$ref": "#/$defs/stable_id" },
        "handoff_properties": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "bounded",
              "source_linked",
              "evidence_citing",
              "typed_verdict",
              "content_addressed",
              "commands",
              "exit_state",
              "logs",
              "repair_causality"
            ]
          }
        },
        "protected_obligation_ids": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stable_id" }
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stable_id" }
        }
      }
    },
    "spawn_proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_id",
        "protected_obligation_ids",
        "children",
        "parallel_sets",
        "wait_policy",
        "integration_owner"
      ],
      "properties": {
        "proposal_id": { "$ref": "#/$defs/stable_id" },
        "protected_obligation_ids": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stable_id" }
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/child" }
        },
        "parallel_sets": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 32,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/stable_id" }
          }
        },
        "wait_policy": { "enum": ["all", "any", "dependency_ready"] },
        "integration_owner": { "$ref": "#/$defs/stable_id" }
      }
    },
    "execution_shape": {
      "enum": ["single", "independent_parallel", "ordered", "independent_candidates", "independent_review", "bounded_batch"]
    },
    "clarification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic_id", "question", "evidence_refs"],
      "properties": {
        "topic_id": { "$ref": "#/$defs/stable_id" },
        "question": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "evidence_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/stable_id" } }
      }
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "request", "evidence_refs"],
      "properties": {
        "kind": { "enum": ["authority", "budget", "model_capability", "resource", "human_decision"] },
        "request": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "evidence_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/stable_id" } }
      }
    },
    "finish_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obligation_id", "evidence_refs"],
      "properties": {
        "obligation_id": { "$ref": "#/$defs/stable_id" },
        "evidence_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/stable_id" } }
      }
    }
  }
}
