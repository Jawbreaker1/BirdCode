{
  "name": "birdcode-workspace",
  "private": true,
  "version": "0.1.0",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "build": "npm run build --workspace @birdcode/desktop",
    "cache:clean": "node scripts/build_cache.mjs clean",
    "cache:clean:apply": "node scripts/build_cache.mjs clean --apply",
    "cache:inspect": "node scripts/build_cache.mjs inspect",
    "cargo": "node scripts/birdcode_cargo.mjs",
    "dev": "npm run tauri:dev --workspace @birdcode/desktop",
    "repo:health": "node scripts/repository_health.mjs",
    "test": "npm run test --workspace @birdcode/desktop",
    "test:build-cache": "node --test scripts/build_cache.test.mjs",
    "test:repo-health": "node --test scripts/repository_health.test.mjs",
    "typecheck": "npm run typecheck --workspace @birdcode/desktop"
  }
}
