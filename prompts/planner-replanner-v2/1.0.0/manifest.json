        {"type": "object", "additionalProperties": false, "required": ["source", "terminal_event_id", "tool_call_id"], "properties": {"source": {"const": "tool_terminal"}, "terminal_event_id": {"$ref": "#/$defs/uuid"}, "tool_call_id": {"$ref": "#/$defs/uuid"}}},
        {"type": "object", "additionalProperties": false, "required": ["source", "evidence_artifact", "evidence_digest"], "properties": {"source": {"const": "runtime_evidence"}, "evidence_artifact": {"$ref": "#/$defs/child_failure_artifact"}, "evidence_digest": {"$ref": "#/$defs/sha256"}}}
      ]},
      "child_failed": {"type": "object", "additionalProperties": false, "required": ["contract_version", "binding", "finished_event_id", "completed_model_calls", "completed_tool_calls", "kind", "retry", "cause", "evidence_artifact", "evidence_digest", "diagnostic"], "properties": {"contract_version": {"const": 1}, "binding": {"$ref": "#/$defs/child_binding"}, "finished_event_id": {"$ref": "#/$defs/uuid"}, "completed_model_calls": {"type": "integer", "minimum": 0}, "completed_tool_calls": {"type": "integer", "minimum": 0}, "kind": {"enum": ["model", "tool", "context", "budget", "protocol", "durable_state"]}, "retry": {"enum": ["never", "requires_new_attempt"]}, "cause": {"$ref": "#/$defs/failure_cause"}, "evidence_artifact": {"$ref": "#/$defs/child_failure_artifact"}, "evidence_digest": {"$ref": "#/$defs/sha256"}, "diagnostic": {"not": {"type": "null"}}}},
