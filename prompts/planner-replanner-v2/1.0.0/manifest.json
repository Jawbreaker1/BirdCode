        {"type": "object", "additionalProperties": false, "required": ["kind", "evidence_id", "child_handoff", "normalized_content_sha256"], "properties": {"kind": {"const": "child_handoff"}, "evidence_id": {"type": "string", "minLength": 1, "maxLength": 512}, "child_handoff": {"$ref": "#/$defs/verified_handoff"}, "normalized_content_sha256": {"$ref": "#/$defs/sha256"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "evidence_id", "child_failed", "normalized_content_sha256"], "properties": {"kind": {"const": "child_failed"}, "evidence_id": {"type": "string", "minLength": 1, "maxLength": 512}, "child_failed": {"$ref": "#/$defs/child_failed"}, "normalized_content_sha256": {"$ref": "#/$defs/sha256"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "evidence_id", "child_cancelled", "normalized_content_sha256"], "properties": {"kind": {"const": "child_cancelled"}, "evidence_id": {"type": "string", "minLength": 1, "maxLength": 512}, "child_cancelled": {"$ref": "#/$defs/child_cancelled"}, "normalized_content_sha256": {"$ref": "#/$defs/sha256"}}}
      ]},
