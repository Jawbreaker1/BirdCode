      "root_obligation_ref": {"type": "object", "additionalProperties": false, "required": ["obligation_id", "obligation_sha256"], "properties": {"obligation_id": {"type": "string", "minLength": 1, "maxLength": 128}, "obligation_sha256": {"$ref": "#/$defs/sha256"}}},
      "root_verification_target": {"type": "object", "additionalProperties": false, "required": ["kind", "selector", "question", "obligation_refs"], "properties": {"kind": {"enum": ["repository_tree", "repository_file", "repository_search", "existing_evidence"]}, "selector": {"type": "string"}, "question": {"type": "string"}, "obligation_refs": {"type": "array", "items": {"$ref": "#/$defs/root_obligation_ref"}}}},
      "root_work_order": {"type": "object", "additionalProperties": false, "required": ["local_id", "objective", "obligation_refs", "depends_on", "proposed_verification_targets"], "properties": {"local_id": {"type": "string", "minLength": 1}, "objective": {"type": "string", "minLength": 1}, "obligation_refs": {"type": "array", "items": {"$ref": "#/$defs/root_obligation_ref"}}, "depends_on": {"type": "array", "items": {"type": "string"}}, "proposed_verification_targets": {"type": "array", "items": {"$ref": "#/$defs/root_verification_target"}}}},
      "root_decision_evidence": {"type": "object", "additionalProperties": false, "required": ["section", "basis"], "properties": {"section": {"type": "string"}, "basis": {"type": "string"}}},
      "root_plan_output": {"type": "object", "additionalProperties": false, "required": ["schema_version", "root_snapshot_sha256", "planner_policy_sha256", "context_manifest_sha256", "directive", "rationale", "decision_evidence", "work_orders", "clarification_questions", "escalation_requests"], "properties": {"schema_version": {"const": 1}, "root_snapshot_sha256": {"$ref": "#/$defs/sha256"}, "planner_policy_sha256": {"$ref": "#/$defs/sha256"}, "context_manifest_sha256": {"$ref": "#/$defs/sha256"}, "directive": {"const": "plan"}, "rationale": {"type": "string"}, "decision_evidence": {"type": "array", "items": {"$ref": "#/$defs/root_decision_evidence"}}, "work_orders": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/root_work_order"}}, "clarification_questions": {"type": "array", "maxItems": 0}, "escalation_requests": {"type": "array", "maxItems": 0}}},
      "accepted_root_plan": {"type": "object", "additionalProperties": false, "required": ["contract_version", "review_event_id", "review_id", "proposal_event_id", "plan_revision", "plan_digest", "plan_artifact", "critique_artifact", "validation_evidence_artifact", "plan"], "properties": {"contract_version": {"const": 1}, "review_event_id": {"$ref": "#/$defs/uuid"}, "review_id": {"$ref": "#/$defs/uuid"}, "proposal_event_id": {"$ref": "#/$defs/uuid"}, "plan_revision": {"type": "integer", "minimum": 0}, "plan_digest": {"$ref": "#/$defs/sha256"}, "plan_artifact": {"$ref": "#/$defs/accepted_plan_artifact"}, "critique_artifact": {"$ref": "#/$defs/plan_critique_artifact"}, "validation_evidence_artifact": {"$ref": "#/$defs/plan_validation_artifact"}, "plan": {"$ref": "#/$defs/root_plan_output"}}},
      "child_binding": {"type": "object", "additionalProperties": false, "required": ["work_order_id", "execution_id", "attempt_id", "child_actor_id", "context_id", "work_order_digest", "context_manifest_digest"], "properties": {"work_order_id": {"$ref": "#/$defs/plan_child_uuid"}, "execution_id": {"$ref": "#/$defs/uuid"}, "attempt_id": {"$ref": "#/$defs/uuid"}, "child_actor_id": {"$ref": "#/$defs/uuid"}, "context_id": {"$ref": "#/$defs/uuid"}, "work_order_digest": {"$ref": "#/$defs/sha256"}, "context_manifest_digest": {"$ref": "#/$defs/sha256"}}},
      "handoff_citation": {"type": "object", "additionalProperties": false, "required": ["tool_call_id", "observed_event_id", "result_artifact"], "properties": {"tool_call_id": {"$ref": "#/$defs/uuid"}, "observed_event_id": {"$ref": "#/$defs/uuid"}, "result_artifact": {"$ref": "#/$defs/artifact"}}},
      "handoff_finding": {"type": "object", "additionalProperties": false, "required": ["finding_id", "statement", "confidence", "evidence"], "properties": {"finding_id": {"type": "string", "minLength": 1, "maxLength": 128}, "statement": {"type": "string", "minLength": 1, "maxLength": 8192}, "confidence": {"enum": ["low", "medium", "high"]}, "evidence": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/handoff_citation"}}}},
      "handoff_unknown": {"type": "object", "additionalProperties": false, "required": ["unknown_id", "question"], "properties": {"unknown_id": {"type": "string", "minLength": 1, "maxLength": 128}, "question": {"type": "string", "minLength": 1, "maxLength": 8192}}},
      "handoff_followup": {"type": "object", "additionalProperties": false, "required": ["followup_id", "text"], "properties": {"followup_id": {"type": "string", "minLength": 1, "maxLength": 128}, "text": {"type": "string", "minLength": 1, "maxLength": 8192}}},
      "child_handoff_content": {"type": "object", "additionalProperties": false, "required": ["contract_version", "binding", "handoff_id", "status", "summary", "findings", "unknowns", "recommended_followups"], "properties": {"contract_version": {"const": 1}, "binding": {"$ref": "#/$defs/child_binding"}, "handoff_id": {"$ref": "#/$defs/uuid"}, "status": {"enum": ["complete", "partial", "blocked"]}, "summary": {"type": "string", "minLength": 1, "maxLength": 16384}, "findings": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/handoff_finding"}}, "unknowns": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/handoff_unknown"}}, "recommended_followups": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/handoff_followup"}}}},
      "verified_handoff": {"type": "object", "additionalProperties": false, "required": ["contract_version", "committed_event_id", "handoff_artifact", "handoff"], "properties": {"contract_version": {"const": 1}, "committed_event_id": {"$ref": "#/$defs/uuid"}, "handoff_artifact": {"$ref": "#/$defs/child_handoff_artifact"}, "handoff": {"$ref": "#/$defs/child_handoff_content"}}},
